# ── Database (per service) ────────────────────────────────────────────────────
# Each service connects to its own MySQL database.
# The default username is root; replace the password with your MySQL root password.

DB_ROOT_PASSWORD=your_mysql_root_password

# Individual service overrides (optional – the defaults above apply if omitted)
AUTH_DB_URL=jdbc:mysql://localhost:3306/auth_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
AUTH_DB_USERNAME=root
AUTH_DB_PASSWORD=your_mysql_root_password

EMPLOYEE_DB_URL=jdbc:mysql://localhost:3306/employee_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
EMPLOYEE_DB_USERNAME=root
EMPLOYEE_DB_PASSWORD=your_mysql_root_password

ATTENDANCE_DB_URL=jdbc:mysql://localhost:3306/attendance_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ATTENDANCE_DB_USERNAME=root
ATTENDANCE_DB_PASSWORD=your_mysql_root_password

LEAVE_DB_URL=jdbc:mysql://localhost:3306/leave_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
LEAVE_DB_USERNAME=root
LEAVE_DB_PASSWORD=your_mysql_root_password

NOTIFICATION_DB_URL=jdbc:mysql://localhost:3306/notification_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
NOTIFICATION_DB_USERNAME=root
NOTIFICATION_DB_PASSWORD=your_mysql_root_password

# ── JWT (must be identical across all backend services) ───────────────────────
# Use a long random string (64+ characters recommended).
JWT_SECRET=change-this-to-a-very-long-random-secret-at-least-64-chars-long

# ── SMTP (transactional email from notification-service) ─────────────────────
# Gmail example: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Service ports (defaults shown; only override if ports are taken) ──────────
# GATEWAY_PORT=8080
# AUTH_SERVICE_PORT=8081
# EMPLOYEE_SERVICE_PORT=8082
# ATTENDANCE_SERVICE_PORT=8083
# LEAVE_SERVICE_PORT=8084
# NOTIFICATION_SERVICE_PORT=8085

# ── Expected check-in time & standard workday hours ──────────────────────────
EXPECTED_CHECK_IN=09:00
STANDARD_HOURS=8.0
